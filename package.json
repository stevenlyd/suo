{
  "name": "@stevenlyd/suo",
  "version": "0.3.1",
  "description": "A shuttle for thought: one decision at a time, into form.",
  "type": "module",
  "private": true,
  "keywords": [
    "pi-package",
    "agent-skills",
    "product-discovery",
    "decision-frontier",
    "suo"
  ],
  "bin": {
    "suo": "./dist/cli.js"
  },
  "files": [
    "dist",
    "schemas",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "prepack": "npm run build"
  },
  "pi": {
    "skills": [
      "./skills"
    ]
  },
  "dependencies": {
    "ajv": "8.20.0",
    "esbuild": "0.25.9",
    "graphology": "0.26.0",
    "graphology-dag": "0.4.1",
    "typescript": "5.9.2",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@10.28.1",
  "license": "MIT"
}
