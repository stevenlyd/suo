{
  "name": "@stevenlyd/suo",
  "version": "0.7.0",
  "description": "A shuttle for thought: one decision at a time, into form.",
  "type": "module",
  "private": true,
  "keywords": [
    "pi-package",
    "agent-skills",
    "product-discovery",
    "decision-frontier",
    "suo"
  ],
  "bin": {
    "suo": "./dist/cli.js"
  },
  "files": [
    "dist",
    "schemas",
    "skills",
    "scripts/distribution.mjs",
    "docs/distribution.md",
    "docs/testing/distribution.md",
    "plugin.json",
    ".claude-plugin",
    ".agents/plugins",
    "gemini-extension.json",
    "distribution-lock.json",
    "README.md",
    "LICENSE",
    "docs/validation-upgrade.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm distribution:check",
    "prepack": "npm run distribution:check",
    "distribution:generate": "node scripts/distribution.mjs --write",
    "distribution:check": "node scripts/distribution.mjs --check",
    "test:package": "node test/package-e2e.mjs"
  },
  "pi": {
    "skills": [
      "./skills"
    ]
  },
  "dependencies": {
    "ajv": "8.20.0",
    "esbuild": "0.25.9",
    "graphology": "0.26.0",
    "graphology-dag": "0.4.1",
    "typescript": "5.9.2",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@10.28.1",
  "license": "MIT",
  "author": {
    "name": "Steven Liu"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/stevenlyd/suo"
  }
}
