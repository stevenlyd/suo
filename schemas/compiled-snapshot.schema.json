{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:suo:schema:compiled-snapshot:v2",
  "title": "Suo Compiled Snapshot (Non-Authority)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "revision",
    "product",
    "modules",
    "decisions",
    "proposals",
    "handoffs",
    "realizations",
    "closures"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "product": {
      "$ref": "#/$defs/product"
    },
    "modules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/module"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decision"
      }
    },
    "proposals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/proposal"
      }
    },
    "handoffs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/handoff"
      }
    },
    "realizations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/realization"
      }
    },
    "closures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/closure"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "nonEmpty": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "initialIdea",
        "activeSlice",
        "profile",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/nonEmpty"
        },
        "initialIdea": {
          "$ref": "#/$defs/nonEmpty"
        },
        "activeSlice": {
          "$ref": "#/$defs/nonEmpty"
        },
        "profile": {
          "$ref": "#/$defs/nonEmpty"
        },
        "createdAt": {
          "$ref": "#/$defs/timestamp"
        },
        "updatedAt": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "text": {
          "$ref": "#/$defs/nonEmpty"
        }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objective",
        "frozenBehavior",
        "scope",
        "nonGoals",
        "acceptance",
        "requiredChecks",
        "checkRationale"
      ],
      "properties": {
        "objective": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "path",
                "content",
                "digest"
              ],
              "properties": {
                "kind": {
                  "const": "markdown"
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "content": {
                  "type": "string"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          ]
        },
        "frozenBehavior": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "nonGoals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "acceptance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/acceptance"
          }
        },
        "requiredChecks": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/requiredCheck"
          }
        },
        "checkRationale": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "phase",
        "definitionStatus",
        "dependencies",
        "contract",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/nonEmpty"
        },
        "phase": {
          "$ref": "#/$defs/nonEmpty"
        },
        "definitionStatus": {
          "enum": [
            "candidate",
            "shaping",
            "frozen",
            "deferred",
            "superseded",
            "retired"
          ]
        },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "contract": {
          "$ref": "#/$defs/contract"
        },
        "createdAt": {
          "$ref": "#/$defs/timestamp"
        },
        "updatedAt": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "alternative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/nonEmpty"
        },
        "tradeoffs": {
          "type": "string"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "moduleId",
        "question",
        "status",
        "alternatives",
        "prerequisites",
        "evidenceRefs",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "moduleId": {
          "$ref": "#/$defs/id"
        },
        "question": {
          "$ref": "#/$defs/nonEmpty"
        },
        "status": {
          "enum": [
            "open",
            "proposed",
            "approved",
            "deferred",
            "superseded"
          ]
        },
        "alternatives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/alternative"
          }
        },
        "recommendation": {
          "type": "string"
        },
        "ownerChoice": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        },
        "prerequisites": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "supersedes": {
          "$ref": "#/$defs/id"
        },
        "createdAt": {
          "$ref": "#/$defs/timestamp"
        },
        "updatedAt": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "approved"
              }
            }
          },
          "then": {
            "required": [
              "ownerChoice",
              "rationale"
            ],
            "properties": {
              "ownerChoice": {
                "$ref": "#/$defs/nonEmpty"
              },
              "rationale": {
                "$ref": "#/$defs/nonEmpty"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "deferred"
              }
            }
          },
          "then": {
            "required": [
              "rationale"
            ],
            "properties": {
              "rationale": {
                "$ref": "#/$defs/nonEmpty"
              }
            }
          }
        }
      ]
    },
    "operation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "module"
          ],
          "properties": {
            "type": {
              "const": "create_module"
            },
            "module": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "title"
              ],
              "properties": {
                "id": {
                  "$ref": "#/$defs/id"
                },
                "title": {
                  "$ref": "#/$defs/nonEmpty"
                },
                "phase": {
                  "$ref": "#/$defs/nonEmpty"
                },
                "contract": {
                  "$ref": "#/$defs/contract"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "moduleId",
            "patch"
          ],
          "properties": {
            "type": {
              "const": "update_module"
            },
            "moduleId": {
              "$ref": "#/$defs/id"
            },
            "patch": {
              "type": "object",
              "additionalProperties": false,
              "required": [],
              "properties": {
                "title": {
                  "$ref": "#/$defs/nonEmpty"
                },
                "phase": {
                  "$ref": "#/$defs/nonEmpty"
                },
                "contract": {
                  "$ref": "#/$defs/contract"
                }
              },
              "minProperties": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "moduleId"
          ],
          "properties": {
            "type": {
              "const": "delete_module"
            },
            "moduleId": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "moduleId"
          ],
          "properties": {
            "type": {
              "const": "retire_module"
            },
            "moduleId": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "moduleId",
            "dependencyId"
          ],
          "properties": {
            "type": {
              "const": "connect_modules"
            },
            "moduleId": {
              "$ref": "#/$defs/id"
            },
            "dependencyId": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "moduleId",
            "dependencyId"
          ],
          "properties": {
            "type": {
              "const": "disconnect_modules"
            },
            "moduleId": {
              "$ref": "#/$defs/id"
            },
            "dependencyId": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "decision"
          ],
          "properties": {
            "type": {
              "const": "record_decision"
            },
            "decision": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "moduleId",
                "question",
                "alternatives",
                "prerequisites",
                "evidenceRefs",
                "choice",
                "rationale"
              ],
              "properties": {
                "id": {
                  "$ref": "#/$defs/id"
                },
                "moduleId": {
                  "$ref": "#/$defs/id"
                },
                "question": {
                  "$ref": "#/$defs/nonEmpty"
                },
                "alternatives": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/alternative"
                  }
                },
                "recommendation": {
                  "type": "string"
                },
                "prerequisites": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/$defs/id"
                  }
                },
                "evidenceRefs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "choice": {
                  "$ref": "#/$defs/nonEmpty"
                },
                "rationale": {
                  "$ref": "#/$defs/nonEmpty"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "decisionId",
            "patch"
          ],
          "properties": {
            "type": {
              "const": "update_decision"
            },
            "decisionId": {
              "$ref": "#/$defs/id"
            },
            "patch": {
              "type": "object",
              "additionalProperties": false,
              "required": [],
              "properties": {
                "question": {
                  "$ref": "#/$defs/nonEmpty"
                },
                "alternatives": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/alternative"
                  }
                },
                "recommendation": {
                  "type": "string"
                },
                "prerequisites": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/$defs/id"
                  }
                },
                "evidenceRefs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "minProperties": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "decisionId"
          ],
          "properties": {
            "type": {
              "const": "delete_decision"
            },
            "decisionId": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "decisionId",
            "choice",
            "rationale"
          ],
          "properties": {
            "type": {
              "const": "approve_decision"
            },
            "decisionId": {
              "$ref": "#/$defs/id"
            },
            "choice": {
              "$ref": "#/$defs/nonEmpty"
            },
            "rationale": {
              "$ref": "#/$defs/nonEmpty"
            },
            "evidenceRefs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/nonEmpty"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "decisionId",
            "rationale"
          ],
          "properties": {
            "type": {
              "const": "defer_decision"
            },
            "decisionId": {
              "$ref": "#/$defs/id"
            },
            "rationale": {
              "$ref": "#/$defs/nonEmpty"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "decisionId"
          ],
          "properties": {
            "type": {
              "const": "reopen_decision"
            },
            "decisionId": {
              "$ref": "#/$defs/id"
            },
            "successorId": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "moduleId"
          ],
          "properties": {
            "type": {
              "const": "freeze_module"
            },
            "moduleId": {
              "$ref": "#/$defs/id"
            },
            "expectedAssignee": {
              "$ref": "#/$defs/nonEmpty"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "realizationId",
            "reason"
          ],
          "properties": {
            "type": {
              "const": "reopen_closure"
            },
            "realizationId": {
              "$ref": "#/$defs/id"
            },
            "reason": {
              "$ref": "#/$defs/nonEmpty"
            },
            "decisionId": {
              "$ref": "#/$defs/id"
            }
          }
        }
      ]
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "summary",
        "baseDigest",
        "operations",
        "submittedAt",
        "baseRevision"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "enum": [
            "pending",
            "approved",
            "rejected"
          ]
        },
        "summary": {
          "$ref": "#/$defs/nonEmpty"
        },
        "baseRevision": {
          "type": "integer",
          "minimum": 0
        },
        "scopeDigest": {
          "$ref": "#/$defs/nonEmpty"
        },
        "baseDigest": {
          "$ref": "#/$defs/nonEmpty"
        },
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/operation"
          }
        },
        "submittedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "decidedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "rejectionReason": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "pending"
              }
            }
          },
          "then": {
            "properties": {
              "operations": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "moduleId",
        "status",
        "decisionIds",
        "contractDigest",
        "createdAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "moduleId": {
          "$ref": "#/$defs/id"
        },
        "expectedAssignee": {
          "$ref": "#/$defs/nonEmpty"
        },
        "status": {
          "enum": [
            "current",
            "in_delivery",
            "stale",
            "closed"
          ]
        },
        "decisionIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "contractDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "createdAt": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "implementationRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "uri",
        "revision"
      ],
      "properties": {
        "kind": {
          "enum": [
            "commit",
            "pull_request",
            "file",
            "release",
            "deployment"
          ]
        },
        "uri": {
          "$ref": "#/$defs/nonEmpty"
        },
        "revision": {
          "$ref": "#/$defs/nonEmpty"
        }
      }
    },
    "realization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "moduleId",
        "handoffId",
        "definitionDigest",
        "status",
        "agent",
        "implementationRefs",
        "startedAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "moduleId": {
          "$ref": "#/$defs/id"
        },
        "handoffId": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "enum": [
            "in_progress",
            "closure_submitted",
            "closed",
            "reopened",
            "stale"
          ]
        },
        "agent": {
          "$ref": "#/$defs/nonEmpty"
        },
        "implementationRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/implementationRef"
          }
        },
        "closureId": {
          "$ref": "#/$defs/id"
        },
        "startedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "updatedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "definitionDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "acceptanceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acceptanceId",
        "evidence",
        "result"
      ],
      "properties": {
        "acceptanceId": {
          "$ref": "#/$defs/id"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmpty"
          }
        },
        "result": {
          "enum": [
            "pass",
            "partial",
            "not_met"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "result": {
                "const": "pass"
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "minItems": 1,
                "type": "array"
              }
            }
          }
        }
      ]
    },
    "deviation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "consequence",
        "requiresProductDecision"
      ],
      "properties": {
        "description": {
          "$ref": "#/$defs/nonEmpty"
        },
        "consequence": {
          "type": "string"
        },
        "requiresProductDecision": {
          "type": "boolean"
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "id",
        "revision"
      ],
      "properties": {
        "command": {
          "type": "string"
        },
        "system": {
          "type": "string"
        },
        "result": {
          "enum": [
            "pass",
            "fail",
            "not_run"
          ]
        },
        "evidenceRef": {
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "revision": {
          "$ref": "#/$defs/nonEmpty"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "result": {
                "const": "pass"
              }
            }
          },
          "then": {
            "required": [
              "evidenceRef"
            ],
            "properties": {
              "evidenceRef": {
                "$ref": "#/$defs/nonEmpty"
              }
            }
          }
        }
      ]
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "revision",
        "evidenceRef"
      ],
      "properties": {
        "environment": {
          "$ref": "#/$defs/nonEmpty"
        },
        "revision": {
          "$ref": "#/$defs/nonEmpty"
        },
        "evidenceRef": {
          "$ref": "#/$defs/nonEmpty"
        }
      }
    },
    "closure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "realizationId",
        "handoffId",
        "definitionDigest",
        "status",
        "implementationRefs",
        "deliveredBehavior",
        "acceptanceEvidence",
        "checks",
        "deviations",
        "residualRisks",
        "newProductQuestions",
        "submittedAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "realizationId": {
          "$ref": "#/$defs/id"
        },
        "handoffId": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "enum": [
            "submitted",
            "accepted",
            "rejected",
            "stale"
          ]
        },
        "implementationRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/implementationRef"
          }
        },
        "deliveredBehavior": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "acceptanceEvidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/acceptanceEvidence"
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          }
        },
        "deviations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/deviation"
          }
        },
        "residualRisks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "newProductQuestions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deployment": {
          "$ref": "#/$defs/deployment"
        },
        "migrations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cleanup": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "submittedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "decidedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "verifier": {
          "type": "string"
        },
        "rejectionReason": {
          "type": "string"
        },
        "definitionDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "requiredCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "description": {
          "$ref": "#/$defs/nonEmpty"
        }
      }
    },
    "proposalEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "expectedRevision",
        "summary",
        "operations"
      ],
      "properties": {
        "kind": {
          "const": "proposal"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        },
        "summary": {
          "$ref": "#/$defs/nonEmpty"
        },
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/operation"
          },
          "minItems": 1
        }
      }
    },
    "closureSubmission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definitionDigest",
        "implementationRefs",
        "deliveredBehavior",
        "acceptanceEvidence",
        "checks",
        "deviations",
        "residualRisks",
        "newProductQuestions"
      ],
      "properties": {
        "implementationRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/implementationRef"
          }
        },
        "deliveredBehavior": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "acceptanceEvidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/acceptanceEvidence"
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          }
        },
        "deviations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/deviation"
          }
        },
        "residualRisks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "newProductQuestions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deployment": {
          "$ref": "#/$defs/deployment"
        },
        "migrations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cleanup": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "definitionDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "closureEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "handoffId",
        "agent",
        "submission"
      ],
      "properties": {
        "kind": {
          "const": "closure"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "handoffId": {
          "$ref": "#/$defs/id"
        },
        "realizationId": {
          "$ref": "#/$defs/id"
        },
        "agent": {
          "$ref": "#/$defs/nonEmpty"
        },
        "submission": {
          "$ref": "#/$defs/closureSubmission"
        }
      }
    },
    "envelope": {
      "oneOf": [
        {
          "$ref": "#/$defs/proposalEnvelope"
        },
        {
          "$ref": "#/$defs/closureEnvelope"
        }
      ]
    },
    "decisionProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "moduleId",
        "question",
        "alternatives",
        "prerequisites",
        "evidenceRefs"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "moduleId": {
          "$ref": "#/$defs/id"
        },
        "question": {
          "$ref": "#/$defs/nonEmpty"
        },
        "alternatives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/alternative"
          }
        },
        "recommendation": {
          "type": "string"
        },
        "prerequisites": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "supersedes": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "enum": [
            "open",
            "proposed"
          ]
        }
      }
    }
  }
}
