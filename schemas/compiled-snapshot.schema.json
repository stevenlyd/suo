{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stevenlyd.github.io/suo/unit-v5.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "product",
    "units",
    "decisions",
    "containment",
    "dependencies",
    "inputPolicy"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        5
      ]
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "labels",
          "expectedAssignee",
          "definition",
          "implementation",
          "documents"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "expectedAssignee": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            ]
          },
          "definition": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "objective",
              "included",
              "behavior",
              "exclusions",
              "scope",
              "decision",
              "criteria",
              "ownObligations",
              "ownRationale",
              "checks",
              "checkRationale",
              "constraints"
            ],
            "properties": {
              "objective": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "included": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "behavior": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "exclusions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "scope": {
                "enum": [
                  "open",
                  "bounded"
                ]
              },
              "decision": {
                "enum": [
                  "proposed",
                  "experimental",
                  "approved",
                  "deferred"
                ]
              },
              "criteria": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "text"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    }
                  }
                }
              },
              "ownObligations": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "id",
                        "text"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "\\S"
                        },
                        "text": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "\\S"
                        }
                      }
                    }
                  }
                ]
              },
              "ownRationale": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                ]
              },
              "checks": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "id",
                        "text"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "\\S"
                        },
                        "text": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "\\S"
                        }
                      }
                    }
                  }
                ]
              },
              "checkRationale": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                ]
              },
              "constraints": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "text",
                    "scope",
                    "rule"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "scope": {
                      "enum": [
                        "self",
                        "subtree"
                      ]
                    },
                    "rule": {
                      "anyOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "key",
                            "allowed"
                          ],
                          "properties": {
                            "key": {
                              "type": "string",
                              "minLength": 1,
                              "pattern": "\\S"
                            },
                            "allowed": {
                              "type": "array",
                              "items": {
                                "type": "string",
                                "minLength": 1,
                                "pattern": "\\S"
                              }
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "implementation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "state",
              "definitionDigest",
              "inputDigest",
              "coverage",
              "gaps"
            ],
            "properties": {
              "state": {
                "enum": [
                  "unknown",
                  "not_started",
                  "in_progress",
                  "implemented"
                ]
              },
              "definitionDigest": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                ]
              },
              "inputDigest": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                ]
              },
              "coverage": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "criterionId",
                    "path",
                    "symbol",
                    "kind"
                  ],
                  "properties": {
                    "criterionId": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "symbol": {
                      "anyOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "\\S"
                        }
                      ]
                    },
                    "kind": {
                      "enum": [
                        "source",
                        "test"
                      ]
                    }
                  }
                }
              },
              "gaps": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            }
          },
          "documents": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "unitId",
          "question",
          "alternatives",
          "recommendation",
          "status",
          "choice",
          "rationale",
          "prerequisites"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "unitId": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "alternatives": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "label",
                "tradeoffs"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "tradeoffs": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    }
                  ]
                }
              }
            }
          },
          "recommendation": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            ]
          },
          "status": {
            "enum": [
              "open",
              "proposed",
              "approved",
              "deferred",
              "superseded"
            ]
          },
          "choice": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            ]
          },
          "rationale": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            ]
          },
          "prerequisites": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      }
    },
    "containment": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "parent",
          "child"
        ],
        "properties": {
          "parent": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "child": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "consumer",
          "prerequisite",
          "require",
          "at"
        ],
        "properties": {
          "consumer": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "prerequisite": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "require": {
            "enum": [
              "contract",
              "implementation",
              "verification"
            ]
          },
          "at": {
            "enum": [
              "start",
              "verify",
              "accept"
            ]
          }
        }
      }
    },
    "inputPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nonRuntimePaths",
        "rationale"
      ],
      "properties": {
        "nonRuntimePaths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    }
  }
}
